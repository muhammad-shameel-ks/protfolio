# Contact form — Resend email-only (no DB)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
# Verified sender: after verifying barchy.online in Resend, use noreply@shameel.barchy.online
# Before verification, keep onboarding@resend.dev
RESEND_FROM=Portfolio <onboarding@resend.dev>
RESEND_TO=hi@shameel.dev

# Turnstile — bot protection for contact form
# Get your sitekey from https://dash.cloudflare.com/turnstile
PUBLIC_TURNSTILE_SITEKEY=your-sitekey
TURNSTILE_SECRET=your-secret
# Comma-separated frontend hostnames the backend will accept (no localhost in production)
TURNSTILE_HOSTNAMES=localhost,127.0.0.1,shameel.barchy.online

# Optional: Cloudflare Web Analytics beacon token (from Cloudflare dashboard > Web Analytics)
# CLOUDFLARE_BEACON_TOKEN=your-token-here
