---
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-xs font-medium">
  <ol class="flex flex-wrap items-center gap-1.5 text-fg-faint">
    {crumbs.map((c, i) => (
      <li class="flex items-center gap-1.5">
        {c.href ? (
          <a href={c.href} class="hover:text-accent transition-colors underline-offset-4 hover:underline">{c.label}</a>
        ) : (
          <span class="text-fg" aria-current="page">{c.label}</span>
        )}
        {i < crumbs.length - 1 && (
          <span class="text-fg-faint/50" aria-hidden="true">/</span>
        )}
      </li>
    ))}
  </ol>
</nav>
