---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
---

<Layout title="Page not found — Shameel | AI Automation & Full-Stack" description="The page you’re looking for doesn’t exist. Head back to Shameel’s portfolio — hire me, view work, or get in touch.">
  <main class="min-h-[70svh] px-6 md:px-12 lg:px-20 py-10">
    <div class="max-w-3xl mx-auto">
      <Breadcrumbs crumbs={[{label:"Home", href:"/"}, {label:"404"}]} />
      <div class="mt-16 text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-pastel-orange/40 border border-orange-200/40 text-xs font-semibold text-accent mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-accent" /> 404 — Lost in the cluster
        </div>
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-fg mb-4">That page took a wrong turn.</h1>
        <p class="text-fg-muted text-lg leading-relaxed max-w-xl mx-auto mb-8">
          It might have been moved, renamed, or it never existed — like my sleep schedule during a VAIO incident at 2 AM.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-accent text-white font-bold shadow-lg hover:bg-accent-dark transition-colors">
            Back to home
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          <a href="/#projects" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white border border-border text-fg font-semibold hover:border-accent/40 transition-colors">View work</a>
          <a href="/#contact" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white border border-border text-fg font-semibold hover:border-accent/40 transition-colors">Hire me</a>
        </div>
        <p class="text-xs text-fg-faint mt-10">If you followed a link from elsewhere, <a href="/#contact" class="underline underline-offset-4 hover:text-accent">let me know</a> and I’ll fix it.</p>
      </div>
    </div>
  </main>
</Layout>
