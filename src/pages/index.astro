---
import Layout from '../layouts/Layout.astro';
import Shell from '../components/Shell';
import Hero from '../components/react/Hero';
import FloatingShapes from '../components/react/FloatingShapes';
import StoryBlock from '../components/react/StoryBlock';
import TextReveal from '../components/react/TextReveal';
import ProjectList from '../components/react/ProjectList';
import ProxyProofStrip from '../components/react/ProxyProofStrip';
import FAQ from '../components/react/FAQ';
import PortraitPlaceholder from '../components/react/PortraitPlaceholder';
import ContactForm from '../components/react/ContactForm';
import InfraFlow from '../components/react/InfraFlow';
import TechStack from '../components/react/TechStack';
import Footer from '../components/react/Footer';
import WhatIBuild from '../components/react/WhatIBuild';

export const prerender = true;
---

<Layout title="Shameel — AI Automation & Full-Stack Development">
	<!-- Decorative floating background shapes -->
	<FloatingShapes client:load />

	<Shell client:load>
	<div class="relative z-10">
		<!-- Hero section -->
		<Hero client:load />

		<!-- Chapter 01 — Origin story: builds trust, shows self-taught grit -->
		<section id="chapter-01">
			<StoryBlock
				client:visible
				icon="rocket"
				eyebrow="Chapter 01 — The Origin"
				heading="I didn't start with a CS degree. I started with curiosity and a broken laptop."
				body="Most people discover programming through a structured curriculum. I discovered it by trying to make my computer do things it wasn't supposed to. That broken laptop eventually ran Arch Linux, then a tiling window manager, then a custom setup I built called Barchy Reborn — a leaner adaptation of Omarchy. Somewhere along the way, I realized — if I can bend an OS to my will, I can probably build software too."
				aside="Yes, I use Arch. No, I won't stop mentioning it."
			/>
		</section>

		<TextReveal
			client:visible
			text="I got tired of doing the same thing twice, so I built an agent to do it."
			highlightWords={["tired", "agent"]}
		/>

		<!-- What I Build -->
		<WhatIBuild client:visible />

		<!-- Projects — the proof -->
		<section id="projects">
			<ProjectList client:visible />
		</section>

		<!-- Chapter 03 — How I Work -->
		<section id="how-i-work">
			<StoryBlock
				client:visible
				warm={true}
				icon="brain"
				eyebrow="Chapter 03 — How I Work"
				heading="AI doesn't replace me. It makes me dangerous."
				body="I use AI as an engineering multiplier. I don't treat AI as a chatbot. I build systems around it — agents that call tools, interact with APIs, reason over context, and execute real workflows. My development workflow is increasingly agentic: AI handles repetitive implementation and investigation while I focus on architecture, product decisions, debugging, and shipping."
				aside="Agentic development · Tool calling · API integration · Workflow automation · Full-stack engineering."
			/>
		</section>

		<!-- Proxy proof strip — verifiable social proof -->
		<ProxyProofStrip client:visible />

		<!-- Chapter 04 — Selected Experience -->
		<section id="experience" class="px-6 md:px-12 lg:px-20 py-16 md:py-20">
			<div class="max-w-5xl mx-auto">
				<span class="font-[Silkscreen] text-[12px] tracking-widest uppercase text-accent">Chapter 04 — Selected Experience</span>
				<h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-fg mt-2 mb-8">Where I've been. What I shipped.</h2>
				<div class="space-y-8 border-l border-border pl-6 relative">
					<div class="absolute left-0 top-1 bottom-1 w-px bg-gradient-to-b from-accent/40 via-border to-transparent pointer-events-none" aria-hidden="true"></div>

					<div class="relative">
						<span class="absolute -left-[29px] top-1 w-2.5 h-2.5 rounded-full bg-accent border-2 border-bg" aria-hidden="true"></span>
						<div class="flex flex-wrap items-center gap-3">
							<img src="/logos/speehive.webp" alt="SpeeHive logo" width="40" height="40" class="w-10 h-10 rounded-lg object-contain border border-border bg-white p-1 shrink-0" loading="lazy" decoding="async" />
							<div class="flex-1 min-w-0">
								<div class="flex flex-wrap items-baseline gap-2">
									<span class="font-mono text-xs font-bold text-accent">July 2026 — Current</span>
									<span class="text-sm font-bold text-fg">SpeeHive — AI Automation Engineer</span>
									<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-pastel-green/40 border border-green-200/40 text-[10px] font-bold tracking-wider uppercase text-green-700">Now</span>
								</div>
								<div class="text-xs text-fg-faint">Palakkad, Kerala</div>
							</div>
						</div>
						<ul class="text-sm leading-relaxed text-fg-muted mt-3 sm:ml-[3.25rem] space-y-1.5 list-disc list-inside marker:text-accent">
							<li>Built an AI-powered Asana bot that retrieves repos, modifies code, and updates tasks automatically.</li>
							<li>Rewrote legacy .NET and Angular applications as modern Next.js apps, including an internal expense tracker.</li>
							<li>Integrated agentic AI workflows into daily development.</li>
							<li>Designed and built a scrolling storytelling website.</li>
							<li>Diagnosed and fixed database issues during QA.</li>
						</ul>
					</div>

					<div class="relative">
						<span class="absolute -left-[29px] top-1 w-2.5 h-2.5 rounded-full bg-white border-2 border-border" aria-hidden="true"></span>
						<div class="flex flex-wrap items-center gap-3">
							<img src="/logos/ksdc.webp" alt="KSDC logo" width="56" height="40" class="w-14 h-10 rounded-lg object-contain border border-border bg-white p-1.5 shrink-0" loading="lazy" decoding="async" />
							<div class="flex-1 min-w-0">
								<div class="flex flex-wrap items-baseline gap-2">
									<span class="font-mono text-xs font-semibold text-fg-faint">Nov 2025 — Jan 2026</span>
									<span class="text-sm font-bold text-fg">Kerala State Development Corporation for SC/ST — Software Developer</span>
								</div>
								<div class="text-xs text-fg-faint">Thrissur, Kerala</div>
							</div>
						</div>
						<ul class="text-sm leading-relaxed text-fg-muted mt-3 sm:ml-[4.25rem] space-y-1.5 list-disc list-inside marker:text-accent">
							<li>Resolved database and migration issues for a government agency's .NET and MySQL systems.</li>
							<li>Fixed errors in an application migrating from a legacy system.</li>
							<li>Diagnosed and fixed migration-related database issues, restoring data accuracy.</li>
						</ul>
						<p class="text-sm leading-relaxed text-fg-muted mt-2 sm:ml-[4.25rem]">Also built <a href="https://github.com/muhammad-shameel-ks/ksdc-smart-helper" class="underline underline-offset-4 hover:text-accent">KSDC Smart Helper</a> — SQL tooling used daily by non-technical staff.</p>
					</div>

					<div class="relative">
						<span class="absolute -left-[29px] top-1 w-2.5 h-2.5 rounded-full bg-white border-2 border-border" aria-hidden="true"></span>
						<div class="flex flex-wrap items-center gap-3">
							<img src="/logos/stthomas.webp" alt="St Thomas College logo" width="40" height="40" class="w-10 h-10 rounded-lg object-contain border border-border bg-white p-1 shrink-0" loading="lazy" decoding="async" />
							<div class="flex-1 min-w-0">
								<div class="flex flex-wrap items-baseline gap-2">
									<span class="font-mono text-xs font-semibold text-fg-faint">2022 — 2027 (expected)</span>
									<span class="text-sm font-bold text-fg">BSc Computer Science</span>
									<span class="text-xs text-fg-faint">— St Thomas College Thrissur (University of Calicut)</span>
								</div>
							</div>
						</div>
						<p class="text-sm leading-relaxed text-fg-muted mt-2 sm:ml-[3.25rem]">Shipped <a href="/projects/scentance" class="underline underline-offset-4 hover:text-accent">Scentance</a> (live e-commerce, real revenue) and a homelab K3s cluster on a VAIO while finishing the degree. Homelab taught more than any tutorial — the 2 AM crash is the point.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- The Engineering Behind It — demoted, compact -->
		<section id="infra" class="px-6 md:px-12 lg:px-20 pt-16 md:pt-20 pb-0 bg-surface/30 border-t border-border/60">
			<div class="max-w-5xl mx-auto text-center md:text-left">
				<span class="font-[Silkscreen] text-[12px] tracking-widest uppercase text-accent">The Engineering Behind It</span>
				<h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-fg mt-2">I also build the infrastructure my software runs on.</h2>
				<p class="text-sm md:text-base text-fg-muted font-light leading-relaxed mt-3 max-w-2xl mx-auto md:mx-0">From self-hosted K3s clusters to automated CI/CD pipelines, I like understanding what happens after git push.</p>
			</div>
		</section>
		<!-- Infra pipeline -->
		<InfraFlow client:load />
		<div class="px-6 md:px-12 lg:px-20 pb-16 md:pb-20 bg-surface-warm border-b border-border/70">
			<div class="max-w-5xl mx-auto">
				<div class="rounded-2xl bg-white border border-border p-5 flex gap-3 items-start mt-0 relative overflow-hidden">
					<div class="absolute -top-3 -right-3 w-12 h-12 rounded-full bg-accent/5" />
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" class="text-accent mt-0.5 shrink-0"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
					<p class="text-sm text-fg-muted leading-relaxed">The cluster crashed at 2 AM last week. I learned more from that incident than any tutorial could teach.</p>
				</div>
			</div>
		</div>

		<!-- Tech stack grid -->
		<TechStack client:visible />

		<!-- FAQ -->
		<FAQ client:visible />

		<!-- Portrait placeholder + location -->
		<section class="px-6 md:px-12 lg:px-20 py-16 md:py-20 bg-surface/30 border-y border-border/60">
			<div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-10 items-center">
				<PortraitPlaceholder client:visible />
				<div>
					<span class="font-[Silkscreen] text-[12px] tracking-widest uppercase text-accent">Palakkad, Kerala — remote worldwide</span>
					<h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-fg mt-2">AI automation & full-stack engineer.</h2>
					<p class="text-sm leading-relaxed text-fg-muted mt-3">I’m an AI automation & full-stack engineer based in Palakkad, Kerala. I build AI-powered applications and workflows that automate real work — from TypeScript and Next.js to Supabase and deployment. I work async with teams worldwide — IST overlap with EU/MENA, morning overlap with US East. No office — just shipping.</p>
					<div class="mt-6 flex flex-wrap gap-2 text-xs">
						<a href="/projects/scentance" class="px-3 py-2 rounded-full bg-white border border-border hover:border-accent/40 transition-colors">Read Scentance case study</a>
						<a href="/projects/linear-ai-agent" class="px-3 py-2 rounded-full bg-white border border-border hover:border-accent/40 transition-colors">Linear AI Agent</a>
						<a href="/projects/asana-coding-agent" class="px-3 py-2 rounded-full bg-white border border-border hover:border-accent/40 transition-colors">Asana Coding Agent</a>
					</div>
					<div class="mt-6 flex flex-wrap gap-3 text-xs text-fg-faint">
						<a href="/privacy" class="underline underline-offset-4 hover:text-accent">Privacy</a>
						<span>·</span>
						<a href="/minimal" class="underline underline-offset-4 hover:text-accent">Minimal version</a>
						<span>·</span>
						<a href="/sitemap.xml" class="underline underline-offset-4 hover:text-accent">Sitemap</a>
					</div>
				</div>
			</div>
		</section>

		<!-- Chapter 05 — The Connection -->
		<section id="contact">
			<ContactForm client:visible />
		</section>

		<!-- Footer -->
		<Footer client:visible />
	</div>
	</Shell>
</Layout>
