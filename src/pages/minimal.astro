---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import { SITE } from "../data/site";
---

<Layout title="Muhammad Shameel KS — Software Engineer | AI Automation & Full-Stack Development" description="Software engineer focused on building useful products, AI agents, and workflows that automate real work. BSc CS 2022-2027 expected — shipped Linear AI Agent, Asana Coding Agent, Scentance, homelab K3s on VAIO.">
  <main class="px-6 md:px-8 py-10 md:py-14">
    <div class="max-w-[720px] mx-auto">
      <!-- Header — identity -->
      <header class="flex gap-5 items-start">
        <a href="/" class="shrink-0" aria-label="View full portfolio">
          <picture>
            <source srcset="/portrait.webp" type="image/webp" />
            <img src="/portrait.jpg" alt="Portrait of Muhammad Shameel KS" width="88" height="88" class="w-[88px] h-[88px] rounded-2xl object-cover border border-border shadow-sm" loading="eager" decoding="async" />
          </picture>
        </a>
        <div class="min-w-0 flex-1">
          <h1 class="text-[28px] font-extrabold tracking-tight leading-none text-fg">Muhammad Shameel KS</h1>
          <p class="text-[15px] text-fg-muted leading-snug mt-1">Software engineer focused on building useful products, AI agents, and workflows that automate real work.</p>
          <p class="font-[Silkscreen] text-[11px] tracking-widest uppercase text-accent mt-2">Palakkad, Kerala — remote worldwide · Reply in 12h</p>
          <div class="flex flex-wrap gap-2 mt-3">
            <a href="#contact" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-accent text-white text-xs font-bold hover:bg-accent-dark transition-colors">Hire me</a>
            <a href="/" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-white border border-border text-fg text-xs font-semibold hover:border-accent/40 transition-colors">Full portfolio →</a>
            <a href="/resume.pdf" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-white border border-border text-fg text-xs font-semibold hover:border-accent/40 transition-colors">Resume</a>
          </div>
        </div>
      </header>

      <!-- Social + quick links -->
      <div class="flex flex-wrap items-center gap-3 mt-6 text-xs">
        <a href={SITE.github} target="_blank" rel="noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface border border-border hover:border-accent/40 transition-colors"><img src="/github-light.svg" alt="GitHub logo" width="14" height="14" class="w-3.5 h-3.5" /> GitHub</a>
        <a href={SITE.linkedin} target="_blank" rel="noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface border border-border hover:border-accent/40 transition-colors"><img src="/linkedin.png" alt="LinkedIn logo" width="14" height="14" class="w-3.5 h-3.5 object-contain opacity-70" onerror="this.style.display='none'" /> LinkedIn</a>
        <a href={`mailto:${SITE.email}`} class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface border border-border hover:border-accent/40 transition-colors">Email</a>
        <span class="text-fg-faint">·</span>
        <a href="/projects/linear-ai-agent" class="underline underline-offset-4 hover:text-accent">Linear AI Agent</a>
        <a href="/projects/asana-coding-agent" class="hover:text-accent underline underline-offset-4">Asana Coding Agent</a>
        <a href="/projects/scentance" class="hover:text-accent underline underline-offset-4">Scentance</a>
      </div>

      <!-- Intro — one paragraph -->
      <div class="mt-10 prose prose-sm max-w-none prose-p:text-fg-muted prose-p:leading-relaxed prose-a:text-accent">
        <p>I didn't start with a CS degree — I started with a broken laptop, then Arch Linux, Hyprland, and a custom setup I call <strong>Barchy Reborn</strong>. I build AI agents that automate real work and full-stack products from frontend to deployment. I like understanding what happens after git push — from self-hosted K3s to automated pipelines.</p>
      </div>

      <!-- Timeline — karpathy style, your theme -->
      <section class="mt-10">
        <h2 class="font-[Silkscreen] text-[12px] tracking-widest uppercase text-fg-faint mb-4">Timeline</h2>
        <div class="space-y-7 border-l border-border pl-6 relative">
          <div class="absolute left-0 top-1 bottom-1 w-px bg-gradient-to-b from-accent/40 via-border to-transparent pointer-events-none" aria-hidden="true"></div>

          <!-- 2026 - Present — SpeeHive -->
          <div class="relative">
            <span class="absolute -left-[29px] top-1 w-2.5 h-2.5 rounded-full bg-accent border-2 border-bg" aria-hidden="true"></span>
            <div class="flex flex-wrap items-baseline gap-2">
              <span class="font-mono text-xs font-bold text-accent">July 2026 — Present</span>
              <span class="text-sm font-bold text-fg">SpeeHive — AI Automation Engineer</span>
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-pastel-green/40 border border-green-200/40 text-[10px] font-bold tracking-wider uppercase text-green-700">Now</span>
            </div>
            <div class="mt-2 flex gap-3">
              <img src="/logos/speehive.webp" alt="SpeeHive logo" width="40" height="40" class="w-10 h-10 rounded-lg object-contain border border-border bg-white p-1 shrink-0" loading="lazy" decoding="async" />
              <div class="flex-1">
                <p class="text-sm leading-relaxed text-fg-muted">AI Automation Engineer at SpeeHive, Palakkad. Building AI-powered applications and agentic workflows.</p>
                <ul class="mt-2 text-sm leading-relaxed text-fg-muted list-disc list-inside marker:text-accent space-y-1">
                  <li>Built an AI-powered Asana bot that retrieves repos, modifies code, and updates tasks automatically.</li>
                  <li>Rewrote legacy .NET and Angular apps as modern Next.js apps, including an internal expense tracker.</li>
                  <li>Integrated agentic AI workflows into daily development; designed scrolling storytelling website.</li>
                  <li>Diagnosed and fixed database issues during QA.</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Nov 2025 — Jan 2026 — KSDC -->
          <div class="relative">
            <span class="absolute -left-[29px] top-1 w-2.5 h-2.5 rounded-full bg-white border-2 border-border" aria-hidden="true"></span>
            <div class="flex flex-wrap items-baseline gap-2">
              <span class="font-mono text-xs font-semibold text-fg-faint">Nov 2025 — Jan 2026</span>
              <span class="text-sm font-bold text-fg">Kerala State Development Corporation for SC/ST — Software Developer</span>
            </div>
            <div class="mt-2 flex gap-3">
              <img src="/logos/ksdc.webp" alt="KSDC logo" width="56" height="40" class="w-14 h-10 rounded-lg object-contain border border-border bg-white p-1.5 shrink-0" loading="lazy" decoding="async" />
              <div class="flex-1">
                <ul class="text-sm leading-relaxed text-fg-muted list-disc list-inside marker:text-accent space-y-1">
                  <li>Resolved database and migration issues for a government agency's .NET and MySQL systems.</li>
                  <li>Fixed errors in an application migrating from a legacy system.</li>
                  <li>Diagnosed and fixed migration-related database issues, restoring data accuracy.</li>
                </ul>
                <p class="text-sm leading-relaxed text-fg-muted mt-2">Also built <a href="https://github.com/muhammad-shameel-ks/ksdc-smart-helper" target="_blank" rel="noreferrer" class="underline underline-offset-4">KSDC Smart Helper</a> — auto-generates SQL for non-technical staff, used live daily.</p>
              </div>
            </div>
          </div>

          <!-- 2022-2027 — BSc -->
          <div class="relative">
            <span class="absolute -left-[29px] top-1 w-2.5 h-2.5 rounded-full bg-white border-2 border-border" aria-hidden="true"></span>
            <div class="flex flex-wrap items-baseline gap-2">
              <span class="font-mono text-xs font-semibold text-fg-faint">2022 — 2027 (expected)</span>
              <span class="text-sm font-bold text-fg">BSc Computer Science</span>
              <span class="text-xs text-fg-faint">— St Thomas College Thrissur (University of Calicut)</span>
            </div>
            <div class="mt-2 flex gap-3">
              <img src="/logos/stthomas.webp" alt="St Thomas College logo" width="40" height="40" class="w-10 h-10 rounded-lg object-contain border border-border bg-white p-1 shrink-0" loading="lazy" decoding="async" />
              <p class="text-sm leading-relaxed text-fg-muted flex-1">Shipped <a href="/projects/scentance" class="underline underline-offset-4">Scentance</a> (live e-commerce, real revenue) and homelab K3s on a VAIO while finishing the degree. Homelab taught more than any tutorial — the 2 AM crash is the point. See full story on <a href="/" class="underline underline-offset-4">/</a>.</p>
            </div>
          </div>

          <!-- 2027 → future -->
          <div class="relative">
            <span class="absolute -left-[29px] top-1 w-2.5 h-2.5 rounded-full bg-pastel-orange/60 border-2 border-orange-200" aria-hidden="true"></span>
            <div class="flex flex-wrap items-baseline gap-2">
              <span class="font-mono text-xs font-bold text-accent">2027 →</span>
              <span class="text-sm font-bold text-fg">AI agents & automation at scale</span>
            </div>
            <p class="text-sm leading-relaxed text-fg-muted mt-2">Next: building AI agents and automation that scale — from tool-calling workflows to full-stack products. Terraform, observable homelab, and self-hosted infra stay as supporting knowledge, not identity. Palakkad as base, remote worldwide. If you want that kind of builder — <a href="#contact" class="underline underline-offset-4">hire me</a>, I reply in 12h.</p>
          </div>
        </div>
      </section>

      <!-- Projects — minimal list -->
      <section class="mt-10">
        <h2 class="font-[Silkscreen] text-[12px] tracking-widest uppercase text-fg-faint mb-3">Selected work</h2>
        <div class="space-y-3">
          <a href="/projects/linear-ai-agent" class="flex gap-3 p-3 rounded-xl border border-border bg-white hover:border-accent/40 hover:shadow-sm transition-all group">
            <div class="w-[72px] h-[48px] rounded-lg bg-pastel-orange/30 border border-orange-100 flex items-center justify-center shrink-0"><span class="font-[Silkscreen] text-[10px] text-orange-600">AGENT</span></div>
            <div class="min-w-0 flex-1">
              <div class="text-sm font-bold text-fg group-hover:text-accent">Linear AI Agent — Tool-calling agent inside Linear</div>
              <div class="text-xs text-fg-muted leading-snug line-clamp-2">OpenAI + Cloudflare Workers, AgentSession webhooks, live tools for coordinates/weather/time. <span class="underline underline-offset-4">Case study →</span></div>
            </div>
          </a>
          <a href="/projects/asana-coding-agent" class="flex gap-3 p-3 rounded-xl border border-border bg-white hover:border-accent/40 hover:shadow-sm transition-all group">
            <div class="w-[72px] h-[48px] rounded-lg bg-pastel-yellow/30 border border-yellow-100 flex items-center justify-center shrink-0"><span class="font-[Silkscreen] text-[10px] text-yellow-700">AGENT</span></div>
            <div class="min-w-0 flex-1">
              <div class="text-sm font-bold text-fg group-hover:text-accent">Asana Coding Agent — AI-powered development automation</div>
              <div class="text-xs text-fg-muted leading-snug line-clamp-2">Built at SpeeHive: retrieves repos, works on code, updates Asana tasks. MCP wiring for OpenAI agents. <span class="underline underline-offset-4">Case study →</span></div>
            </div>
          </a>
          <a href="/projects/office-pal" class="flex gap-3 p-3 rounded-xl border border-border bg-white hover:border-accent/40 hover:shadow-sm transition-all group">
            <img src="/projects/office-pal.png" alt="Office Pal screenshot" width="72" height="48" class="w-[72px] h-[48px] rounded-lg object-cover border border-border shrink-0" loading="lazy" decoding="async" />
            <div class="min-w-0 flex-1">
              <div class="text-sm font-bold text-fg group-hover:text-accent">Office Pal — College Management</div>
              <div class="text-xs text-fg-muted leading-snug line-clamp-2">Exam seating for 2000, anti-cheat algorithm, print-ready PDFs. <span class="underline underline-offset-4">Case study →</span></div>
            </div>
          </a>
          <a href="/projects/stock-salt" class="flex gap-3 p-3 rounded-xl border border-border bg-white hover:border-accent/40 hover:shadow-sm transition-all group">
            <img src="/projects/stock-salt.png" alt="Stock Salt screenshot" width="72" height="48" class="w-[72px] h-[48px] rounded-lg object-cover border border-border shrink-0" loading="lazy" decoding="async" />
            <div class="min-w-0 flex-1">
              <div class="text-sm font-bold text-fg group-hover:text-accent">Stock Salt — Real-time Inventory SaaS</div>
              <div class="text-xs text-fg-muted leading-snug line-clamp-2">One source of truth for 5 outlets. Supabase Realtime, &lt;200ms sync. <span class="underline underline-offset-4">Case study →</span></div>
            </div>
          </a>
        </div>
        <p class="text-xs text-fg-faint mt-3">More on <a href="/#projects" class="underline underline-offset-4 hover:text-accent">portfolio</a> and <a href={SITE.github} target="_blank" rel="noreferrer" class="underline underline-offset-4 hover:text-accent">GitHub</a>.</p>
      </section>

      <!-- Contact — minimal -->
      <section id="contact" class="mt-10 p-5 rounded-2xl border border-border bg-white">
        <h2 class="font-[Silkscreen] text-[12px] tracking-widest uppercase text-accent">Hire me</h2>
        <p class="text-sm text-fg-muted leading-relaxed mt-2">Tell me what you want to build — budget and timeline help me reply faster. I read every word.</p>
        <form id="minimal-contact" class="mt-4 space-y-3">
          <input required name="name" placeholder="Your name" class="w-full px-4 py-3 rounded-xl bg-surface border border-border focus:border-accent focus:ring-1 focus:ring-accent outline-none text-sm" />
          <input required name="email" type="email" placeholder="your@email.com" class="w-full px-4 py-3 rounded-xl bg-surface border border-border focus:border-accent focus:ring-1 focus:ring-accent outline-none text-sm" />
          <textarea required name="message" rows="4" placeholder="What are you looking to build? Budget/timeline helps me reply faster." class="w-full px-4 py-3 rounded-xl bg-surface border border-border focus:border-accent focus:ring-1 focus:ring-accent outline-none text-sm resize-none"></textarea>
          <input type="text" name="_honeypot" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button type="submit" class="w-full py-3.5 rounded-xl bg-accent text-white text-sm font-bold hover:bg-accent-dark transition-colors">Send — I reply in 12h</button>
          <p id="contact-status" class="text-xs text-fg-faint text-center min-h-[1rem]"></p>
        </form>
        <p class="text-xs text-fg-faint mt-3">Or email <a href={`mailto:${SITE.email}`} class="underline underline-offset-4 hover:text-accent">{SITE.email}</a> · <a href="/privacy" class="underline underline-offset-4 hover:text-accent">Privacy</a> · <a href="/" class="underline underline-offset-4 hover:text-accent">Full portfolio</a></p>
      </section>

      <!-- Footer — minimal -->
      <footer class="mt-10 pt-6 border-t border-border/60 flex flex-wrap items-center justify-between gap-3 text-xs text-fg-faint">
        <span>© {new Date().getFullYear()} — Crafted with chai</span>
        <nav class="flex flex-wrap items-center gap-2">
          <a href="/" class="hover:text-accent underline underline-offset-4">Full portfolio</a>
          <span>·</span>
          <a href="/privacy" class="hover:text-accent underline underline-offset-4">Privacy</a>
          <span>·</span>
          <a href="/sitemap.xml" class="hover:text-accent underline underline-offset-4">Sitemap</a>
          <span>·</span>
          <a href={SITE.github} target="_blank" rel="noreferrer" class="hover:text-accent underline underline-offset-4">GitHub</a>
        </nav>
      </footer>
    </div>
  </main>

  <script>
    const form = document.getElementById('minimal-contact') as HTMLFormElement | null;
    const statusEl = document.getElementById('contact-status');
    if (form && statusEl) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = new FormData(form);
        const payload: Record<string,string> = {};
        data.forEach((v,k) => payload[k] = String(v));
        const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
        if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
        statusEl.textContent = '';
        try {
          const res = await fetch('/api/contact', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(payload) });
          const json = await res.json().catch(()=> ({}));
          if (!res.ok) throw new Error(json.error || 'Failed');
          window.location.href = '/thanks';
        } catch (err) {
          statusEl.textContent = (err as Error).message || 'Something went wrong. Email me directly.';
          if (btn) { btn.disabled = false; btn.textContent = 'Send — I reply in 12h'; }
        }
      });
    }
  </script>
</Layout>
