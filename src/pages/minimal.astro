---
import Layout from "../layouts/Layout.astro";
import { SITE } from "../data/site";
---

<Layout title="Muhammad Shameel KS — Full-Stack Engineer & Sysadmin" description="Full-stack engineer walking the DevOps path. Building, running and automating systems from Palakkad, Kerala. BSc CS (2022-2027 expected) — shipped Scentance, Stock Salt, Office Pal, homelab K8s on VAIO.">
  <main class="px-6 md:px-8 py-10 md:py-14">
    <div class="max-w-[720px] mx-auto">
      <!-- Header — identity -->
      <header class="flex gap-5 items-start">
        <a href="/" class="shrink-0" aria-label="View full portfolio">
          <picture>
            <source srcset="/portrait.webp" type="image/webp" />
            <img src="/portrait.jpg" alt="Portrait of Muhammad Shameel KS" width="88" height="88" class="w-[88px] h-[88px] rounded-2xl object-cover border border-border shadow-sm" loading="eager" decoding="async" />
          </picture>
        </a>
        <div class="min-w-0 flex-1">
          <h1 class="text-[28px] font-extrabold tracking-tight leading-none text-fg">Muhammad Shameel KS</h1>
          <p class="text-[15px] text-fg-muted leading-snug mt-1">Full-stack engineer walking the DevOps path. I build, run and automate the systems I create.</p>
          <p class="font-[Silkscreen] text-[11px] tracking-widest uppercase text-accent mt-2">Palakkad, Kerala — remote worldwide · Reply in 12h</p>
          <div class="flex flex-wrap gap-2 mt-3">
            <a href="#contact" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-accent text-white text-xs font-bold hover:bg-accent-dark transition-colors">Hire me</a>
            <a href="/" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-white border border-border text-fg text-xs font-semibold hover:border-accent/40 transition-colors">Full portfolio →</a>
            <a href="/resume.pdf" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-white border border-border text-fg text-xs font-semibold hover:border-accent/40 transition-colors">Resume</a>
          </div>
        </div>
      </header>

      <!-- Social + quick links -->
      <div class="flex flex-wrap items-center gap-3 mt-6 text-xs">
        <a href={SITE.github} target="_blank" rel="noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface border border-border hover:border-accent/40 transition-colors"><img src="/github-light.svg" alt="GitHub logo" width="14" height="14" class="w-3.5 h-3.5" /> GitHub</a>
        <a href={SITE.linkedin} target="_blank" rel="noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface border border-border hover:border-accent/40 transition-colors"><img src="/linkedin.svg" alt="LinkedIn logo" width="14" height="14" class="w-3.5 h-3.5 opacity-70" onerror="this.style.display='none'" /> LinkedIn</a>
        <a href={`mailto:${SITE.email}`} class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface border border-border hover:border-accent/40 transition-colors">Email</a>
        <span class="text-fg-faint">·</span>
        <a href="/projects/scentance" class="underline underline-offset-4 hover:text-accent">Scentance</a>
        <a href="/projects/stock-salt" class="hover:text-accent underline underline-offset-4">Stock Salt</a>
        <a href="/projects/office-pal" class="hover:text-accent underline underline-offset-4">Office Pal</a>
      </div>

      <!-- Intro — one paragraph -->
      <div class="mt-10 prose prose-sm max-w-none prose-p:text-fg-muted prose-p:leading-relaxed prose-a:text-accent">
        <p>I didn't start with a CS degree — I started with a broken laptop, then Arch Linux, Hyprland, and a custom setup I call <strong>Barchy Reborn</strong>. I build lean tools that make someone's Tuesday less painful, then run them myself on a self-hosted K3s cluster on a Sony VAIO.</p>
      </div>

      <!-- Timeline — karpathy style, your theme -->
      <section class="mt-10">
        <h2 class="font-[Silkscreen] text-[12px] tracking-widest uppercase text-fg-faint mb-4">Timeline</h2>
        <div class="space-y-7 border-l border-border pl-6 relative">
          <div class="absolute left-0 top-1 bottom-1 w-px bg-gradient-to-b from-accent/40 via-border to-transparent pointer-events-none" aria-hidden="true"></div>

          <!-- 2026 - Present — SeeHive -->
          <div class="relative">
            <span class="absolute -left-[29px] top-1 w-2.5 h-2.5 rounded-full bg-accent border-2 border-bg" aria-hidden="true"></span>
            <div class="flex flex-wrap items-baseline gap-2">
              <span class="font-mono text-xs font-bold text-accent">Aug 2026 — Present</span>
              <span class="text-sm font-bold text-fg">SeeHive Hive — AI Agentic Developer</span>
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-pastel-green/40 border border-green-200/40 text-[10px] font-bold tracking-wider uppercase text-green-700">Now</span>
            </div>
            <div class="mt-2 flex gap-3">
              <img src="/projects/scentence.png" alt="SeeHive logo placeholder" width="40" height="40" class="w-10 h-10 rounded-lg object-cover border border-border bg-surface hidden sm:block" onerror="this.style.display='none'" />
              <p class="text-sm leading-relaxed text-fg-muted flex-1">Working on SeeHive Hive as an AI agentic developer. Building autonomous workflows and tool-use agents, shipping with AI as a force multiplier — not a crutch. Focus on reliability and fast iteration.</p>
            </div>
          </div>

          <!-- Nov 2025 — KSDC -->
          <div class="relative">
            <span class="absolute -left-[29px] top-1 w-2.5 h-2.5 rounded-full bg-white border-2 border-border" aria-hidden="true"></span>
            <div class="flex flex-wrap items-baseline gap-2">
              <span class="font-mono text-xs font-semibold text-fg-faint">Nov 2025 — Jul 2026</span>
              <span class="text-sm font-bold text-fg">Kerala State Development Corporation for SC/ST — Software Developer</span>
            </div>
            <div class="mt-2 flex gap-3">
              <img src="/microsoft-sql-server.svg" alt="KSDC logo placeholder" width="40" height="40" class="w-10 h-10 rounded-lg object-contain border border-border bg-white p-1.5 hidden sm:block" />
              <p class="text-sm leading-relaxed text-fg-muted flex-1">Built <a href="/projects/office-pal" class="underline underline-offset-4">KSDC Smart Helper</a> — auto-generates SQL for non-technical staff. React + TypeScript + Node + MSSQL. Used live by staff. See the <a href="/projects/office-pal" class="underline underline-offset-4">Office Pal</a> pattern: exam-seating algorithm and role-based dashboards reused here. <a href="/projects/stock-salt" class="underline underline-offset-4">Stock Salt</a> realtime pattern informed the design.</p>
            </div>
          </div>

          <!-- 2022-2027 — BSc -->
          <div class="relative">
            <span class="absolute -left-[29px] top-1 w-2.5 h-2.5 rounded-full bg-white border-2 border-border" aria-hidden="true"></span>
            <div class="flex flex-wrap items-baseline gap-2">
              <span class="font-mono text-xs font-semibold text-fg-faint">2022 — 2027 (expected)</span>
              <span class="text-sm font-bold text-fg">BSc Computer Science</span>
              <span class="text-xs text-fg-faint">— non-linear path, completing alongside production work</span>
            </div>
            <div class="mt-2 flex gap-3">
              <div class="w-10 h-10 rounded-lg bg-pastel-blue/40 border border-blue-200/40 flex items-center justify-center text-blue-700 font-[Silkscreen] text-xs font-bold hidden sm:flex">CS</div>
              <p class="text-sm leading-relaxed text-fg-muted flex-1">Supposed to be 2022-2025, now 2022-2027 because of backlogs. Shipped <a href="/projects/scentance" class="underline underline-offset-4">Scentance</a> (live e-commerce, real revenue) and homelab K3s on a VAIO while finishing the degree. Homelab taught more than any tutorial — the 2 AM crash is the point. See full story on <a href="/" class="underline underline-offset-4">/</a>.</p>
            </div>
          </div>

          <!-- 2027 → future -->
          <div class="relative">
            <span class="absolute -left-[29px] top-1 w-2.5 h-2.5 rounded-full bg-pastel-orange/60 border-2 border-orange-200" aria-hidden="true"></span>
            <div class="flex flex-wrap items-baseline gap-2">
              <span class="font-mono text-xs font-bold text-accent">2027 →</span>
              <span class="text-sm font-bold text-fg">Platform / DevOps in progress</span>
            </div>
            <p class="text-sm leading-relaxed text-fg-muted mt-2">Next: Terraform, observable homelab → production, shipping small AI-assisted tools fast. Palakkad as base, remote worldwide. If you want that kind of builder — <a href="#contact" class="underline underline-offset-4">hire me</a>, I reply in 12h.</p>
          </div>
        </div>
      </section>

      <!-- Projects — minimal list -->
      <section class="mt-10">
        <h2 class="font-[Silkscreen] text-[12px] tracking-widest uppercase text-fg-faint mb-3">Selected work</h2>
        <div class="space-y-3">
          <a href="/projects/scentance" class="flex gap-3 p-3 rounded-xl border border-border bg-white hover:border-accent/40 hover:shadow-sm transition-all group">
            <img src="/projects/scentence.png" alt="Scentance screenshot" width="72" height="48" class="w-[72px] h-[48px] rounded-lg object-cover border border-border shrink-0" loading="lazy" decoding="async" />
            <div class="min-w-0 flex-1">
              <div class="text-sm font-bold text-fg group-hover:text-accent">Scentance — Premium Fragrance E-commerce <span class="ml-1 inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-green-500/10 border border-green-200 text-[10px] font-bold tracking-wider text-green-700">LIVE</span></div>
              <div class="text-xs text-fg-muted leading-snug line-clamp-2">Live at scentenceparfum.com with real revenue. Next.js 16 + Three.js + Supabase. <span class="underline underline-offset-4">Case study →</span></div>
            </div>
          </a>
          <a href="/projects/stock-salt" class="flex gap-3 p-3 rounded-xl border border-border bg-white hover:border-accent/40 hover:shadow-sm transition-all group">
            <img src="/projects/stock-salt.png" alt="Stock Salt screenshot" width="72" height="48" class="w-[72px] h-[48px] rounded-lg object-cover border border-border shrink-0" loading="lazy" decoding="async" />
            <div class="min-w-0 flex-1">
              <div class="text-sm font-bold text-fg group-hover:text-accent">Stock Salt — Real-time Inventory SaaS</div>
              <div class="text-xs text-fg-muted leading-snug line-clamp-2">One source of truth for 5 outlets. Supabase Realtime, <200ms sync. <span class="underline underline-offset-4">Case study →</span></div>
            </div>
          </a>
          <a href="/projects/office-pal" class="flex gap-3 p-3 rounded-xl border border-border bg-white hover:border-accent/40 hover:shadow-sm transition-all group">
            <img src="/projects/office-pal.png" alt="Office Pal screenshot" width="72" height="48" class="w-[72px] h-[48px] rounded-lg object-cover border border-border shrink-0" loading="lazy" decoding="async" />
            <div class="min-w-0 flex-1">
              <div class="text-sm font-bold text-fg group-hover:text-accent">Office Pal — College Management</div>
              <div class="text-xs text-fg-muted leading-snug line-clamp-2">Exam seating for 2000, anti-cheat algorithm, print-ready PDFs. <span class="underline underline-offset-4">Case study →</span></div>
            </div>
          </a>
        </div>
        <p class="text-xs text-fg-faint mt-3">5 more on <a href="/#projects" class="underline underline-offset-4 hover:text-accent">portfolio</a> and <a href={SITE.github} target="_blank" rel="noreferrer" class="underline underline-offset-4 hover:text-accent">GitHub</a>.</p>
      </section>

      <!-- Contact — minimal -->
      <section id="contact" class="mt-10 p-5 rounded-2xl border border-border bg-white">
        <h2 class="font-[Silkscreen] text-[12px] tracking-widest uppercase text-accent">Hire me</h2>
        <p class="text-sm text-fg-muted leading-relaxed mt-2">Tell me what you want to build — budget and timeline help me reply faster. I read every word.</p>
        <form id="minimal-contact" class="mt-4 space-y-3">
          <input required name="name" placeholder="Your name" class="w-full px-4 py-3 rounded-xl bg-surface border border-border focus:border-accent focus:ring-1 focus:ring-accent outline-none text-sm" />
          <input required name="email" type="email" placeholder="your@email.com" class="w-full px-4 py-3 rounded-xl bg-surface border border-border focus:border-accent focus:ring-1 focus:ring-accent outline-none text-sm" />
          <textarea required name="message" rows="4" placeholder="What are you looking to build? Budget/timeline helps me reply faster." class="w-full px-4 py-3 rounded-xl bg-surface border border-border focus:border-accent focus:ring-1 focus:ring-accent outline-none text-sm resize-none"></textarea>
          <input type="text" name="_honeypot" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button type="submit" class="w-full py-3.5 rounded-xl bg-accent text-white text-sm font-bold hover:bg-accent-dark transition-colors">Send — I reply in 12h</button>
          <p id="contact-status" class="text-xs text-fg-faint text-center min-h-[1rem]"></p>
        </form>
        <p class="text-xs text-fg-faint mt-3">Or email <a href={`mailto:${SITE.email}`} class="underline underline-offset-4 hover:text-accent">{SITE.email}</a> · <a href="/privacy" class="underline underline-offset-4 hover:text-accent">Privacy</a> · <a href="/" class="underline underline-offset-4 hover:text-accent">Full portfolio</a></p>
      </section>

      <!-- Footer — minimal -->
      <footer class="mt-10 pt-6 border-t border-border/60 flex flex-wrap items-center justify-between gap-3 text-xs text-fg-faint">
        <span>© {new Date().getFullYear()} — Crafted with chai</span>
        <nav class="flex flex-wrap items-center gap-2">
          <a href="/" class="hover:text-accent underline underline-offset-4">Full portfolio</a>
          <span>·</span>
          <a href="/privacy" class="hover:text-accent underline underline-offset-4">Privacy</a>
          <span>·</span>
          <a href="/sitemap.xml" class="hover:text-accent underline underline-offset-4">Sitemap</a>
          <span>·</span>
          <a href={SITE.github} target="_blank" rel="noreferrer" class="hover:text-accent underline underline-offset-4">GitHub</a>
        </nav>
      </footer>
    </div>
  </main>

  <script>
    const form = document.getElementById('minimal-contact') as HTMLFormElement | null;
    const statusEl = document.getElementById('contact-status');
    if (form && statusEl) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = new FormData(form);
        const payload: Record<string,string> = {};
        data.forEach((v,k) => payload[k] = String(v));
        const btn = form.querySelector('button[type=\"submit\"]') as HTMLButtonElement | null;
        if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
        statusEl.textContent = '';
        try {
          const res = await fetch('/api/contact', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(payload) });
          const json = await res.json().catch(()=> ({}));
          if (!res.ok) throw new Error(json.error || 'Failed');
          window.location.href = '/thanks';
        } catch (err) {
          statusEl.textContent = (err as Error).message || 'Something went wrong. Email me directly.';
          if (btn) { btn.disabled = false; btn.textContent = 'Send — I reply in 12h'; }
        }
      });
    }
  </script>
</Layout>
