---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { caseStudies, caseStudySlugs } from "../../data/caseStudies";
import { SITE } from "../../data/site";

export const prerender = true;

export function getStaticPaths() {
  return caseStudySlugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const study = caseStudies[slug as string];

if (!study) {
  return Astro.redirect("/404");
}

const title = `${study.title} — Case Study | Shameel | AI Automation & Full-Stack`;
const description = study.subtitle;
const canonical = new URL(`/projects/${study.slug}`, Astro.site).toString();
const ogImage = study.heroImage ? new URL(study.heroImage, Astro.site).toString() : `${SITE.siteUrl}/og-image.png`;

const otherStudies = Object.values(caseStudies).filter((s) => s.slug !== study.slug).slice(0,2);
---

<Layout title={title} description={description} ogImage={ogImage} ogUrl={canonical}>
  <main class="px-6 md:px-12 lg:px-20 py-10">
    <div class="max-w-3xl mx-auto">
      <Breadcrumbs crumbs={[{label:"Home", href:"/"}, {label:"Work", href:"/#projects"}, {label: study.title}]} />

      <div class="mt-8">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-pastel-purple/30 border border-purple-200/40 text-xs font-semibold text-purple-700">
          Case study · {study.projectIndex}
        </div>
        <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight text-fg mt-4">{study.title}</h1>
        <p class="text-fg-muted text-lg leading-relaxed mt-2">{study.subtitle}</p>
        <div class="flex flex-wrap items-center gap-3 mt-6">
          <a href={study.link} target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-accent text-white text-sm font-bold shadow-lg hover:bg-accent-dark transition-colors">
            {study.linkLabel}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
          <a href="/#contact" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white border border-border text-fg text-sm font-semibold hover:border-accent/40 transition-colors">Hire me for this</a>
        </div>
      </div>

      {study.heroImage && (
        <div class="mt-10 rounded-2xl overflow-hidden border border-border bg-surface">
          <img src={study.heroImage} alt={`Screenshot of ${study.title} — ${study.subtitle}`} width={1200} height={675} class="w-full h-auto object-cover" loading="eager" decoding="async" />
        </div>
      )}

      <div class="mt-10 space-y-10">
        <section class="bg-white rounded-2xl border border-border p-6 md:p-8">
          <h2 class="font-[Silkscreen] text-xs tracking-widest uppercase text-fg-faint mb-3">The problem</h2>
          <p class="text-sm leading-relaxed text-fg-muted">{study.problem}</p>
        </section>

        <section class="bg-white rounded-2xl border border-border p-6 md:p-8">
          <h2 class="font-[Silkscreen] text-xs tracking-widest uppercase text-fg-faint mb-3">Approach</h2>
          <ul class="space-y-3">
            {study.approach.map((a) => (
              <li class="flex gap-3 text-sm leading-relaxed text-fg-muted">
                <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-accent shrink-0" />
                <span>{a}</span>
              </li>
            ))}
          </ul>
          <div class="mt-6 flex flex-wrap gap-2">
            {study.stack.map((s) => (
              <span class="px-3 py-1.5 rounded-full bg-surface border border-border text-xs font-semibold text-fg-muted">{s}</span>
            ))}
          </div>
        </section>

        <section class="bg-white rounded-2xl border border-border p-6 md:p-8">
          <h2 class="font-[Silkscreen] text-xs tracking-widest uppercase text-fg-faint mb-3">Outcome</h2>
          <ul class="space-y-3">
            {study.outcome.map((o) => (
              <li class="flex gap-3 text-sm leading-relaxed text-fg-muted">
                <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-green-500 shrink-0" />
                <span>{o}</span>
              </li>
            ))}
          </ul>
        </section>

        {study.highlights && (
          <section class="rounded-2xl border border-dashed border-border bg-surface/30 p-6">
            <h3 class="text-xs font-bold text-fg-muted mb-3">Highlights</h3>
            <ul class="space-y-1.5">
              {study.highlights.map((h) => (
                <li class="flex items-center gap-2 text-xs text-fg-muted"><span class="w-1 h-1 rounded-full bg-fg-faint" />{h}</li>
              ))}
            </ul>
          </section>
        )}
      </div>

      <div class="mt-12 flex flex-wrap gap-3">
        <a href="/#projects" class="inline-flex items-center gap-2 text-sm font-semibold text-accent hover:underline underline-offset-4">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          Back to work
        </a>
        <span class="text-fg-faint">·</span>
        <a href="/#contact" class="inline-flex items-center gap-2 text-sm font-semibold text-fg hover:text-accent">Hire me</a>
        <span class="text-fg-faint">·</span>
        <a href="/privacy" class="text-sm text-fg-faint hover:text-accent underline underline-offset-4">Privacy</a>
      </div>

      {otherStudies.length > 0 && (
        <div class="mt-14 border-t border-border pt-8">
          <h3 class="font-[Silkscreen] text-xs tracking-widest uppercase text-fg-faint mb-4">More case studies</h3>
          <div class="grid sm:grid-cols-2 gap-4">
            {otherStudies.map((s) => (
              <a href={`/projects/${s.slug}`} class="rounded-2xl border border-border bg-white p-5 hover:border-accent/40 hover:shadow-md transition-all group">
                <div class="text-xs font-semibold text-accent">{s.title}</div>
                <div class="text-sm text-fg-muted leading-snug mt-1 line-clamp-2">{s.subtitle}</div>
                <span class="inline-flex items-center gap-1 text-xs font-semibold text-fg mt-3 group-hover:text-accent">Read case study <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    name: study.title,
    description: study.subtitle,
    url: canonical,
    image: ogImage,
    author: { "@type": "Person", name: SITE.name, url: SITE.siteUrl },
    about: study.stack,
  })} />
</Layout>
