{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "protfolio",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "shameel.barchy.online",
      "custom_domain": true
    }
  ]
}
